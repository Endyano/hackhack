# --- Supabase ---
SUPABASE_URL=
# Service role key: used by the FastAPI backend only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: safe for frontend use if we ever call Supabase directly from Next.js.
SUPABASE_ANON_KEY=

# --- Azure AI Foundry ---
# Foundry project endpoint, e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
# Existing Foundry Agent Service agent id, e.g. asst_... Preferred if available.
AZURE_AI_AGENT_ID=
# Optional fallback: resolve one existing agent by exact name when no id is set.
AZURE_AI_AGENT_NAME=
# Older name accepted by the backend as a fallback for the project endpoint.
AZURE_AI_FOUNDRY_PROJECT=
# Auth uses Entra ID via DefaultAzureCredential. For local dev, run `az login`,
# or set AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET for a service principal.

# --- Backend ---
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API (CORS)
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
