# --- Supabase ---
SUPABASE_URL=
# Service role key: used by the FastAPI backend only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: safe for frontend use if we ever call Supabase directly from Next.js.
SUPABASE_ANON_KEY=

# --- Azure AI Foundry ---
# Foundry project endpoint, e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
# Existing Foundry Agent Service agent id, e.g. asst_... Preferred if available.
AZURE_AI_AGENT_ID=
# Optional fallback: resolve one existing agent by exact name when no id is set.
AZURE_AI_AGENT_NAME=
# Older name accepted by the backend as a fallback for the project endpoint.
AZURE_AI_FOUNDRY_PROJECT=
# Auth uses Entra ID via DefaultAzureCredential. For local dev, run `az login`,
# or set AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET for a service principal.

# --- Backend ---
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API (CORS)
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Google Calendar OAuth ---
# Google Cloud Console setup (console.cloud.google.com):
#   1. Create/select a project, then enable the "Google Calendar API"
#      (APIs & Services > Library).
#   2. APIs & Services > OAuth consent screen: set it up in "Testing" mode
#      for a hackathon demo (no Google verification review needed) and add
#      every Google account you'll log in with as a test user.
#   3. APIs & Services > Credentials > Create Credentials > OAuth client ID.
#      Application type: "Web application". Add an "Authorized redirect URI"
#      that EXACTLY matches GOOGLE_OAUTH_REDIRECT_URI below (including the
#      port and path) -- Google rejects any mismatch.
#   4. Copy the generated Client ID / Client Secret into the two vars below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered in step 3 above.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/google/callback
# Random secret used to HMAC-sign the OAuth `state` param (this app has no
# real session/login, so `state` carries the user_id and must be tamper-
# proof). Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GOOGLE_OAUTH_STATE_SECRET=
# Where the backend redirects the browser back to after the OAuth callback.
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
